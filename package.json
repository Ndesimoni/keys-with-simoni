{
  "name": "keys-with-simoni-real-estate-crm",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "Premium React front-end converting the 17-tab Keys with Simoni real estate workbook into a functioning CRM",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "offline": "python3 -m http.server 4173 --directory legacy/offline/public",
    "build:offline": "node scripts/build-offline.cjs",
    "test": "node --test tests/unit/*.test.js tests/smoke/*.test.cjs",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:offline": "node --test tests/smoke/*.test.cjs",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "prettier": "^3.9.9",
    "typescript": "^5.6.3",
    "vite": "^6.4.3"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED"
}
